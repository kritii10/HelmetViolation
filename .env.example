POSTGRES_DB=traffic_intelligence
POSTGRES_USER=traffic_app
# Replace every CHANGE_ME value before running Docker Compose. Do not commit .env.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://traffic_app:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/traffic_intelligence
RABBITMQ_DEFAULT_USER=traffic_worker
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://traffic_worker:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672//
VIOLATION_SERVICE_URL=http://violation-service:8002
MAX_UPLOAD_MB=200
# Provide one helmet/no-helmet model inside the mounted /app/models directory.
HELMET_MODEL_PATH=/app/models/helmet_model.pt
YOLO_CONFIDENCE=0.40
VIOLATION_CONFIRMATION_FRAMES=4
VIOLATION_MAX_FRAME_GAP=1
